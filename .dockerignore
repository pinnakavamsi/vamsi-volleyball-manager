!migrations/**
!deploy/
!deploy/docker/
!deploy/docker/**
!deploy/gunicorn.conf.py
**/__pycache__/**
**/*.pyc
**/.DS_Store
**/.env
**/.env.*
**/*.pem
**/*.key
**/*_ed25519
**/*.dump
**/*.backup
**/*.tar.enc
**/build/**
**/dist/**
**/*.egg-info/**
