# Local setup generates isolated credentials with scripts/local_database.py.
DATABASE_URL=postgresql+psycopg://volleyball_app:REPLACE@127.0.0.1:55432/volleyball
MIGRATION_DATABASE_URL=postgresql+psycopg://volleyball_owner:REPLACE@127.0.0.1:55432/volleyball
BACKUP_DATABASE_URL=postgresql+psycopg://volleyball_backup:REPLACE@127.0.0.1:55432/volleyball
TEST_DATABASE_URL=postgresql+psycopg://volleyball_owner:REPLACE@127.0.0.1:55432/volleyball_test
TEST_RUNTIME_URL=postgresql+psycopg://volleyball_app:REPLACE@127.0.0.1:55432/volleyball_test
SECRET_KEY=REPLACE_WITH_RANDOM_48_BYTE_SECRET
APP_ENV=development
SESSION_COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:5050
# Production must use HTTPS, secure cookies and a separate Fernet key.
MFA_ENCRYPTION_KEY=
EMAIL_DELIVERY_MODE=deferred
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Provider disabled until licensing + adapter payload selected.
WEATHER_PROVIDER_URL=
WEATHER_PROVIDER_NAME=
WEATHER_LICENSE_CONFIRMED=false
WEATHER_PROVIDER_TOKEN=
