# VM-only file: /opt/volleyball-manager/config/postgres.env, root:root 0600.
# Init scripts run only for an empty volume. Changing these values later does
# not rotate existing PostgreSQL passwords; use a reviewed ALTER ROLE instead.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=REPLACE_BOOTSTRAP_PASSWORD
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --auth-local=scram-sha-256 --data-checksums
PGDATA=/var/lib/postgresql/18/docker
VOLLEYBALL_OWNER_PASSWORD=REPLACE_OWNER_PASSWORD
VOLLEYBALL_APP_PASSWORD=REPLACE_APP_PASSWORD
VOLLEYBALL_BACKUP_PASSWORD=REPLACE_BACKUP_PASSWORD
