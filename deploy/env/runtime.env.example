# VM-only file: /opt/volleyball-manager/config/runtime.env, root:root 0600.
# Generate unique secrets on the VM. Never commit the populated file.
DATABASE_URL=postgresql+psycopg://volleyball_app:REPLACE_APP_PASSWORD@postgres:5432/volleyball
APP_ENV=production
PUBLIC_BASE_URL=https://volleyball.example.com
SECRET_KEY=REPLACE_WITH_RANDOM_48_BYTE_HEX_SECRET
MFA_ENCRYPTION_KEY=REPLACE_WITH_SEPARATE_FERNET_KEY
SESSION_COOKIE_SECURE=true
TRUST_PROXY_HEADERS=true
TRUSTED_HOSTS=volleyball.example.com,localhost,127.0.0.1
PRIVATE_STORAGE_PATH=/app/instance/files
GUNICORN_WORKERS=1
GUNICORN_THREADS=4

# Deferred delivery preserves mail jobs until a real SMTP provider is configured.
EMAIL_DELIVERY_MODE=deferred
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WEATHER_PROVIDER_URL=
WEATHER_PROVIDER_NAME=
WEATHER_LICENSE_CONFIRMED=false
WEATHER_PROVIDER_TOKEN=
BACKUP_STATUS_PATH=
